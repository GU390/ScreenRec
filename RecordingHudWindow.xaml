<Window x:Class="ScreenRec.RecordingHudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="录制中"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        FontFamily="Microsoft YaHei UI">
    <Border Background="#E012161C" BorderBrush="#FF2F6BEA" BorderThickness="1" CornerRadius="8" Padding="10,7">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="Dot" Width="9" Height="9" Fill="#FF3B82F6" VerticalAlignment="Center" Margin="0,0,7,0" />
                <TextBlock x:Name="TimeText" Text="00:00" Foreground="White" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock x:Name="InfoText" Text="" Foreground="#9AA6B2" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <Image x:Name="PreviewImage" Height="56" Margin="0,6,0,0" Stretch="UniformToFill" Visibility="Collapsed" />
            <Button x:Name="StopButton" Content="停止录像 (F9)" Height="24" Margin="0,8,0,0" Cursor="Hand"
                    Background="#E03B82F6" Foreground="White" BorderThickness="0" FontSize="12">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF5B9BFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Border>
</Window>
